#!/usr/bin/env python3
import shutil
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gtk


APP_ID = "os.alex.studio"


TOOLS = [
    ("google-chrome", "Web", "google-chrome", [["google-chrome"], ["chromium"], ["xdg-open", "https://www.google.com"]]),
    ("alexos-files", "Files", "alexos-files", [["/usr/local/bin/alexos-files"]]),
    ("alexos-write", "Write", "alexos-write", [["/usr/local/bin/alexos-write"]]),
    ("alexos-draw", "Draw", "alexos-draw", [["/usr/local/bin/alexos-draw"]]),
    ("alexos-calc", "Calc", "alexos-calc", [["/usr/local/bin/alexos-calc"]]),
    ("librecad", "CAD", "applications-engineering", [["librecad"]]),
    ("org.freecadweb.FreeCAD", "3D CAD", "applications-engineering", [["freecad"]]),
    ("blender", "3D Art", "applications-graphics", [["blender"]]),
    ("gimp", "Image Art", "applications-graphics", [["gimp"]]),
    ("org.gnome.Terminal", "Terminal", "org.gnome.Terminal", [["gnome-terminal"], ["kgx"], ["xterm"]]),
    ("alexos-software-updates", "Updates", "system-software-update", [["/usr/local/bin/alexos-software-updates"]]),
    ("alexos-icon-changer", "Icons", "alexos-icon-changer", [["/usr/local/bin/alexos-icon-changer"]]),
]


def command_exists(command):
    if command.startswith("/"):
        return shutil.which(command) is not None
    return shutil.which(command) is not None


class AlexOSStudio(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.window = None
        self.status = None

    def do_activate(self):
        self.window = Adw.ApplicationWindow(application=self)
        self.window.set_title("AlexOS Studio")
        self.window.set_default_size(760, 560)

        header = Adw.HeaderBar()

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.append(header)
        root.append(self.build_page())

        self.window.set_content(root)
        self.window.present()

    def build_page(self):
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        outer.set_margin_top(24)
        outer.set_margin_bottom(24)
        outer.set_margin_start(24)
        outer.set_margin_end(24)

        title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
        title_row.set_valign(Gtk.Align.CENTER)

        logo = Gtk.Image.new_from_icon_name("alexos-logo")
        logo.set_pixel_size(64)
        title_row.append(logo)

        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        title = Gtk.Label(label="AlexOS Studio")
        title.add_css_class("title-1")
        title.set_xalign(0)
        subtitle = Gtk.Label(label="Create, build, and update.")
        subtitle.add_css_class("dim-label")
        subtitle.set_xalign(0)
        title_box.append(title)
        title_box.append(subtitle)
        title_row.append(title_box)
        outer.append(title_row)

        scroller = Gtk.ScrolledWindow()
        scroller.set_vexpand(True)

        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_column_spacing(12)
        flow.set_row_spacing(12)
        flow.set_max_children_per_line(4)
        flow.set_min_children_per_line(2)
        flow.set_homogeneous(True)

        for icon_name, label, fallback_icon, commands in TOOLS:
            flow.append(self.make_tile(icon_name, label, fallback_icon, commands))

        scroller.set_child(flow)
        outer.append(scroller)

        self.status = Gtk.Label(label="Ready")
        self.status.set_xalign(0)
        self.status.add_css_class("dim-label")
        outer.append(self.status)

        return outer

    def make_tile(self, icon_name, label, fallback_icon, commands):
        button = Gtk.Button()
        button.set_hexpand(True)
        button.set_vexpand(False)
        button.add_css_class("flat")
        button.connect("clicked", lambda _button: self.launch(label, commands))

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_margin_top(14)
        box.set_margin_bottom(14)
        box.set_margin_start(12)
        box.set_margin_end(12)
        box.set_halign(Gtk.Align.CENTER)

        image = Gtk.Image.new_from_icon_name(icon_name or fallback_icon)
        image.set_pixel_size(44)
        box.append(image)

        text = Gtk.Label(label=label)
        text.set_wrap(True)
        text.set_justify(Gtk.Justification.CENTER)
        box.append(text)

        button.set_child(box)
        return button

    def launch(self, label, commands):
        for command in commands:
            if command_exists(command[0]):
                try:
                    subprocess.Popen(command)
                    self.status.set_text(f"Opened {label}")
                    return
                except Exception as exc:
                    self.status.set_text(str(exc))
                    return

        self.status.set_text(f"{label} is not installed")


def main():
    app = AlexOSStudio()
    return app.run(sys.argv)


if __name__ == "__main__":
    raise SystemExit(main())
