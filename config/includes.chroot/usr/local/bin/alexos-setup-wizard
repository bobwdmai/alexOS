  background: linear-gradient(135deg, #005e80 0%, #00b4d8 100%);
  color: #ffffff;
  border: 1px solid rgba(0,180,216,0.28);
  box-shadow: 0 2px 18px rgba(0,180,216,0.22);
}
button.suggested-action:hover {
  background: linear-gradient(135deg, #0076a0 0%, #00cef5 100%);
  box-shadow: 0 4px 26px rgba(0,180,216,0.38);
}
button.suggested-action:disabled {
  background: rgba(0,100,130,0.28);
  color: rgba(255,255,255,0.38);
  box-shadow: none;
}

/* ── Step dots ────────────────────────────────────────────────────────── */
.step-dot {
  min-width: 7px;
  min-height: 7px;
  border-radius: 4px;
  background: rgba(0,180,216,0.20);
  margin-left: 4px;
  margin-right: 4px;
}
.step-dot-active {
  min-width: 20px;
  min-height: 7px;
  border-radius: 4px;
  background: #00b4d8;
  margin-left: 4px;
  margin-right: 4px;
}
"""


def take_lock():
    lock_file = open(LOCK_PATH, "w", encoding="utf-8")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(0)
    return lock_file


def ensure_graphical_session():
    if os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"):
        return
    print("AlexOS setup wizard needs a graphical display.", file=sys.stderr)
    sys.exit(1)


def import_gtk():
    import gi

    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, GLib, Gtk

    return Adw, Gdk, GLib, Gtk


Adw, Gdk, GLib, Gtk = import_gtk()


class SetupWizard(Adw.Application):
    def __init__(self):
        super().__init__(application_id="os.alex.setup")
        self.window = None
        self.countdown = 3
        self._step_dots = []
        self._current_step = 0

    def do_activate(self):
        self._install_css()

        self.window = Adw.ApplicationWindow(application=self)
        self.window.set_title("Set Up AlexOS")
        self.window.set_default_size(540, 620)
        self.window.set_resizable(False)
        self.window.add_css_class("setup-window")

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        # Header: brand + logo
        header = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        header.add_css_class("setup-header")
        header.set_margin_top(28)
        header.set_margin_bottom(20)

        logo = self._make_logo()
        logo.set_halign(Gtk.Align.CENTER)
        header.append(logo)

        brand = Gtk.Label(label="ALEXOS")
        brand.add_css_class("brand-word")
        brand.set_halign(Gtk.Align.CENTER)
        header.append(brand)

        outer.append(header)

        # Page stack
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(300)
        self.stack.set_vexpand(True)
        self.stack.add_named(self._welcome_page(), "welcome")
        self.stack.add_named(self._account_page(), "account")
        self.stack.add_named(self._success_page(), "success")
        outer.append(self.stack)

        # Step dots
        dot_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        dot_row.set_halign(Gtk.Align.CENTER)
        dot_row.set_margin_top(14)
        dot_row.set_margin_bottom(20)

        for i in range(3):
            d = Gtk.Box()
            d.add_css_class("step-dot-active" if i == 0 else "step-dot")
            self._step_dots.append(d)
            dot_row.append(d)

        outer.append(dot_row)
        self.window.set_content(outer)
        self.window.present()

    def _install_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(APP_CSS)
        display = Gdk.Display.get_default()
        if display is not None:
            Gtk.StyleContext.add_provider_for_display(
                display,
                provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
            )

    def _set_step(self, step: int):
        self._current_step = step
        for i, dot in enumerate(self._step_dots):
            dot.remove_css_class("step-dot")
            dot.remove_css_class("step-dot-active")
            dot.add_css_class("step-dot-active" if i == step else "step-dot")

    def _make_logo(self):
        display = Gdk.Display.get_default()
        if display is not None:
            theme = Gtk.IconTheme.get_for_display(display)
            for name in ("alexos-logo", "alexos-setup", "distributor-logo-alexos"):
                if theme.has_icon(name):
                    img = Gtk.Image.new_from_icon_name(name)
                    img.set_pixel_size(96)
                    return img
        lbl = Gtk.Label(label="◈")
        lbl.add_css_class("brand-word")
        return lbl

    # ── Page helpers ─────────────────────────────────────────────────────

    def _page_shell(self):
        clamp = Adw.Clamp()
        clamp.set_maximum_size(480)
        clamp.set_tightening_threshold(380)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        box.add_css_class("setup-page")
        box.set_margin_top(32)
        box.set_margin_bottom(32)
        box.set_margin_start(32)
        box.set_margin_end(32)
        clamp.set_child(box)
        return clamp, box

    def _labeled_entry(self, label_text, entry):
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl = Gtk.Label(label=label_text)
        lbl.add_css_class("field-label")
        lbl.set_xalign(0)
        entry.set_hexpand(True)
        vbox.append(lbl)
        vbox.append(entry)
        return vbox

    def _password_entry(self):
        e = Gtk.Entry()
        e.set_visibility(False)
        e.set_input_purpose(Gtk.InputPurpose.PASSWORD)
        return e

    # ── Welcome page ─────────────────────────────────────────────────────

    def _welcome_page(self):
        clamp, box = self._page_shell()
        box.set_valign(Gtk.Align.CENTER)

        title = Gtk.Label(label="Welcome!")
        title.add_css_class("page-title")
        title.set_justify(Gtk.Justification.CENTER)
        title.set_halign(Gtk.Align.CENTER)
        box.append(title)

        sub = Gtk.Label(label="Let's create your account.\nThis only takes a moment.")
        sub.add_css_class("page-subtitle")
        sub.set_justify(Gtk.Justification.CENTER)
        sub.set_halign(Gtk.Align.CENTER)
        sub.set_wrap(True)
        box.append(sub)

        btn = Gtk.Button(label="Get Started →")
        btn.add_css_class("suggested-action")
        btn.set_halign(Gtk.Align.CENTER)
        btn.set_margin_top(10)

        def go(_b):
            self._set_step(1)
            self.stack.set_visible_child_name("account")

        btn.connect("clicked", go)
        box.append(btn)

        note = Gtk.Label(label="AlexOS  ·  Architect Workstation")
        note.add_css_class("dim-note")
        note.set_halign(Gtk.Align.CENTER)
        note.set_margin_top(20)
        box.append(note)

        return clamp

    # ── Account page ─────────────────────────────────────────────────────

    def _account_page(self):
        clamp, box = self._page_shell()

        title = Gtk.Label(label="Create your account")
        title.add_css_class("page-title")
        title.set_xalign(0)
        title.set_wrap(True)
        box.append(title)

        self.username_entry = Gtk.Entry()
        self.username_entry.set_placeholder_text("alex")
        box.append(self._labeled_entry("Login name", self.username_entry))

        self.fullname_entry = Gtk.Entry()
        self.fullname_entry.set_placeholder_text("Alex")
        box.append(self._labeled_entry("Display name", self.fullname_entry))

        self.pw_entry = self._password_entry()
        box.append(self._labeled_entry("Password (8+ characters)", self.pw_entry))

        self.pw_confirm = self._password_entry()
        box.append(self._labeled_entry("Confirm password", self.pw_confirm))

        self.admin_check = Gtk.CheckButton(label="Can install apps and change system settings")
        self.admin_check.set_active(True)
        box.append(self.admin_check)

        self.error_label = Gtk.Label(label="")
        self.error_label.add_css_class("error-label")
        self.error_label.set_wrap(True)
        self.error_label.set_xalign(0)
        box.append(self.error_label)

        self.create_btn = Gtk.Button(label="Create Account")
        self.create_btn.add_css_class("suggested-action")
        self.create_btn.set_halign(Gtk.Align.END)
        self.create_btn.connect("clicked", self._on_create)
        box.append(self.create_btn)

        return clamp

    # ── Success page ─────────────────────────────────────────────────────

    def _success_page(self):
        clamp, box = self._page_shell()
        box.set_valign(Gtk.Align.CENTER)

        icon = Gtk.Image.new_from_icon_name("emblem-ok-symbolic")
        icon.set_pixel_size(80)
        icon.add_css_class("success-icon")
        icon.set_halign(Gtk.Align.CENTER)
        box.append(icon)

        title = Gtk.Label(label="You're all set!")
        title.add_css_class("page-title")
        title.set_justify(Gtk.Justification.CENTER)
        box.append(title)

        self.success_label = Gtk.Label(label="Opening the login screen…")
        self.success_label.add_css_class("page-subtitle")
        self.success_label.set_justify(Gtk.Justification.CENTER)
        box.append(self.success_label)

        return clamp

    # ── Logic ─────────────────────────────────────────────────────────────

    def _validate(self):
        username = self.username_entry.get_text().strip()
        fullname = self.fullname_entry.get_text().strip() or username
        password = self.pw_entry.get_text()
        confirm = self.pw_confirm.get_text()

        if not USERNAME_RE.match(username):
            raise ValueError("Login name: use lowercase letters and numbers. Start with a letter.")
        if username in {"root", LIVE_USER}:
            raise ValueError("That login name is reserved. Pick a different one.")
        if ":" in fullname or "\n" in fullname:
            raise ValueError("Display name contains a character AlexOS cannot use.")
        if len(password) < 8:
            raise ValueError("Password must be at least 8 characters.")
        if ":" in password or "\n" in password:
            raise ValueError("Password contains an invalid character.")
        if password != confirm:
            raise ValueError("The passwords don't match.")
        if subprocess.run([ID, "-u", username], capture_output=True).returncode == 0:
            raise ValueError("That login name is already taken.")

        return username, fullname, password, self.admin_check.get_active()

    def _run_privileged(self, args, input_text=None):
        attempts = []
        if os.geteuid() == 0:
            attempts.append(args)
        else:
            attempts.append(["sudo", "-n", *args])
            attempts.append(["pkexec", *args])

        last_error = None
        for command in attempts:
            try:
                result = subprocess.run(
                    command,
                    input=input_text,
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    check=False,
                )
            except FileNotFoundError as exc:
                last_error = str(exc)
                continue

            if result.returncode == 0:
                return result

            last_error = result.stderr.strip() or result.stdout.strip()

        raise RuntimeError(last_error or "AlexOS could not complete the operation.")

    def _create_account(self, username, fullname, password, grant_sudo):
        self._run_privileged([USERADD, "-m", "-s", "/bin/bash", "-c", fullname, username])
        self._run_privileged([CHPASSWD], input_text=f"{username}:{password}\n")
        if grant_sudo:
            self._run_privileged([USERMOD, "-aG", "sudo", username])
        self._run_privileged([SHELL, "-s"], input_text=FINALIZE_SCRIPT)

    def _on_create(self, _btn):
        self.error_label.set_text("")
        self.create_btn.set_sensitive(False)

        try:
            username, fullname, password, grant_sudo = self._validate()
            self._create_account(username, fullname, password, grant_sudo)
        except Exception as exc:
            self.error_label.set_text(str(exc))
            self.create_btn.set_sensitive(True)
            return

        self._set_step(2)
        self.stack.set_visible_child_name("success")
        GLib.timeout_add_seconds(1, self._tick_countdown)

    def _tick_countdown(self):
        self.countdown -= 1
        if self.countdown <= 0:
            self.success_label.set_text("Opening the login screen now.")
            return False
        s = "second" if self.countdown == 1 else "seconds"
        self.success_label.set_text(f"Login screen opens in {self.countdown} {s}…")
        return True


def main():
    if os.path.exists(SETUP_COMPLETE):
        return 0

    ensure_graphical_session()
    lock_file = take_lock()

    try:
        app = SetupWizard()
        return app.run(sys.argv)
    finally:
        lock_file.close()


if __name__ == "__main__":
    raise SystemExit(main())
