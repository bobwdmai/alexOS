  font-size: 15px;
  padding-left: 12px;
}
entry:focus {
  border-color: rgba(0,180,216,0.52);
  box-shadow: 0 0 0 2px rgba(0,180,216,0.10);
}
entry text {
  color: #e0fbfc;
}
entry placeholder {
  color: #3a6070;
}

/* ── Checkbutton ──────────────────────────────────────────────────────── */
checkbutton {
  color: #94c7d8;
  font-size: 14px;
}

/* ── Buttons ──────────────────────────────────────────────────────────── */
