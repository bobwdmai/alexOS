#!/usr/bin/env python3
import fcntl
import os
import re
import subprocess
import sys

SETUP_COMPLETE = "/var/lib/alexos/setup-complete"
LOCK_PATH = "/tmp/alexos-setup-wizard.lock"
LIVE_USER = "alex"
USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
ID = "/usr/bin/id"
SHELL = "/bin/sh"
USERADD = "/usr/sbin/useradd"
CHPASSWD = "/usr/sbin/chpasswd"
USERMOD = "/usr/sbin/usermod"

GDM_COMPLETE_CONFIG = """\
[daemon]
WaylandEnable = false
AutomaticLoginEnable = false
TimedLoginEnable = false
"""

FINALIZE_SCRIPT = f"""\
set -e
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
install -d -m 0755 /var/lib/alexos
cat > /etc/gdm3/custom.conf <<'GDMEOF'
{GDM_COMPLETE_CONFIG.rstrip()}
GDMEOF
cat > /etc/gdm3/daemon.conf <<'GDMEOF'
{GDM_COMPLETE_CONFIG.rstrip()}
GDMEOF
touch {SETUP_COMPLETE}
systemctl disable alexos-first-boot.service >/dev/null 2>&1 || true
passwd -l {LIVE_USER} >/dev/null 2>&1 || true
usermod -s /usr/sbin/nologin {LIVE_USER} >/dev/null 2>&1 || true
rm -f /etc/sudoers.d/alexos-live
( sleep 3; systemctl restart gdm3 || systemctl restart gdm || true ) >/dev/null 2>&1 &
"""

APP_CSS = b"""
window.setup-window {
  background: linear-gradient(160deg, #080f1c 0%, #0d1b2a 45%, #071421 100%);
}
.setup-page {
  background: transparent;
  color: #e0fbfc;
}

/* ── Header strip ─────────────────────────────────────────────────────── */
.setup-header {
  background: linear-gradient(180deg, rgba(0,180,216,0.10) 0%, transparent 100%);
  border-bottom: 1px solid rgba(0,180,216,0.14);
}

/* ── Typography ───────────────────────────────────────────────────────── */
.brand-word {
  font-size: 34px;
  font-weight: 900;
  color: #e0fbfc;
  letter-spacing: 6px;
}
.page-title {
  font-size: 26px;
  font-weight: 800;
