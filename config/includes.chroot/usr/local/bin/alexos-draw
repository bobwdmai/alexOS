import sys
import math
import xml.etree.ElementTree as ET
from copy import deepcopy
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gio, Gtk

