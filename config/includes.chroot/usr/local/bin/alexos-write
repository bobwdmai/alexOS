separator { background: rgba(0,180,216,0.10); min-width:1px; min-height:1px; }
textview, textview text {
  background: #060f1c; color: #e0fbfc;
  font-family: "Monospace", monospace; font-size: 14px;
  caret-color: #00b4d8;
}
