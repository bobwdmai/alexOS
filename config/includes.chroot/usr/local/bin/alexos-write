entry {
  background: rgba(0,180,216,0.05); border: 1px solid rgba(0,180,216,0.18);
  color: #e0fbfc; border-radius:6px; caret-color:#00b4d8; min-height:30px;
}
entry:focus { border-color: rgba(0,180,216,0.50); }
