#!/usr/bin/env python3
"""AlexOS Files — blueprint-themed file manager."""

import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gio", "2.0")
from gi.repository import Adw, Gdk, GLib, Gio, Gtk

APP_CSS = b"""
window { background: #0a1929; color: #e0fbfc; }
headerbar {
  background: rgba(8,15,28,0.97);
  border-bottom: 1px solid rgba(0,180,216,0.14);
  color: #e0fbfc;
}
button {
  border-radius: 6px; color: #94c8da;
  border: 1px solid rgba(0,180,216,0.12);
  background: rgba(0,180,216,0.05);
  min-height: 30px; padding: 0 10px; font-weight: 600;
}
button:hover { background: rgba(0,180,216,0.13); color: #e0fbfc; }
button.flat { background: transparent; border-color: transparent; }
button.flat:hover { background: rgba(0,180,216,0.10); }
button.pathseg {
  border-radius: 4px; font-size: 13px;
  min-height: 24px; padding: 0 8px; font-weight: 400;
  border: none; background: transparent; color: #7dd3fc;
}
button.pathseg:hover { background: rgba(0,180,216,0.10); color: #e0fbfc; }
separator { background: rgba(0,180,216,0.10); min-width:1px; min-height:1px; }
