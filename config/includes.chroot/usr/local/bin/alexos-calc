#!/usr/bin/env python3
"""AlexOS Calc — blueprint-themed spreadsheet with formula engine."""

import csv
import re
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gio, Gtk

APP_CSS = b"""
window { background: #0a1929; color: #e0fbfc; }
headerbar {
