#!/usr/bin/env bash
set -Eeuo pipefail

if (( EUID != 0 )); then
  exec sudo -n "$0" "$@"
fi

install -d -m 0755 /var/lib/alexos

if ! command -v snap >/dev/null 2>&1; then
  echo "snap command is not available" >&2
  exit 1
fi

systemctl start snapd.socket || true
systemctl start snapd.service || true

for _ in $(seq 1 90); do
  if snap version >/dev/null 2>&1; then
    break
  fi
  sleep 2
done

snap version >/dev/null 2>&1

if ! snap list snap-store >/dev/null 2>&1; then
  snap install snap-store
fi

if ! snap list sweethome3d-homedesign >/dev/null 2>&1 && ! snap list sweethome3d >/dev/null 2>&1; then
  snap install sweethome3d || snap install sweethome3d-homedesign
fi

touch /var/lib/alexos/snap-store-complete
systemctl disable alexos-snap-store.service || true
