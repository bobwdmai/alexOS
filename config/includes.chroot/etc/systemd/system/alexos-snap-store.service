[Unit]
Description=AlexOS First-Boot Snap Store Installer
After=network-online.target snapd.socket
Wants=network-online.target snapd.socket
ConditionPathExists=!/var/lib/alexos/snap-store-complete

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/alexos-install-snap-store
Restart=on-failure
RestartSec=90

[Install]
WantedBy=multi-user.target
